# Copy to env/.env.production (git-ignored) or, better, set these in your host's dashboard.
APP_ENV=production
LOG_LEVEL=INFO
PUBLIC_URL=https://your-app.onrender.com
DATABASE_PATH=/var/data/price-agent.db
NOMINATIM_CONTACT=you@example.com
# MODEL defaults to the value in config.py; set it only to override (check the OpenAI model list)
MAX_SEARCHES=15
MAX_INSIGHT_SEARCHES=10
WORKERS=4
RATE_LIMIT=5
USER_RATE_LIMIT=30
KEY_RATE_LIMIT=60
CACHE_TTL_SECONDS=1800
JOB_WAIT_SECONDS=50
# SECRETS (set in the host dashboard, never in a file): OPENAI_API_KEY, API_KEYS, ADMIN_KEY
