# Local development defaults. Safe to commit: contains no secrets.
# Put your OPENAI_API_KEY in a git-ignored ".env" file or export it in your shell, never here.
APP_ENV=development
LOG_LEVEL=DEBUG
PUBLIC_URL=http://127.0.0.1:8000
DATABASE_PATH=data/dev.db
NOMINATIM_CONTACT=dev@example.com
# Cheap and loose while developing
AI_PROVIDER=auto
MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-6-luna
MAX_SEARCHES=5
MAX_INSIGHT_SEARCHES=4
WORKERS=2
RATE_LIMIT=50
USER_RATE_LIMIT=100
KEY_RATE_LIMIT=200
CACHE_TTL_SECONDS=1800
JOB_WAIT_SECONDS=50
GROQ_MODEL=openai/gpt-oss-120b
HF_MODEL=openai/gpt-oss-120b:fastest
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434/v1
