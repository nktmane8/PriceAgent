# Copy to env/.env.staging (git-ignored) or, better, set these in your host's dashboard.
APP_ENV=staging
LOG_LEVEL=INFO
PUBLIC_URL=https://price-agent-staging.onrender.com
DATABASE_PATH=/var/data/price-agent-staging.db
NOMINATIM_CONTACT=you@example.com
MAX_SEARCHES=8
MAX_INSIGHT_SEARCHES=6
WORKERS=2
RATE_LIMIT=20
# SECRETS (set in the host dashboard, never in a file): OPENAI_API_KEY, API_KEYS, ADMIN_KEY
