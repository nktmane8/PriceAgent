# Copy to ".env" (git-ignored) for personal local overrides, including secrets.
# Precedence: real environment variables > .env > env/.env.<APP_ENV>
APP_ENV=development                # development | test | staging | production
ANTHROPIC_API_KEY=                 # SECRET, required
API_KEYS=                          # SECRET, optional, comma-separated partner keys (20+ chars in production)
ADMIN_KEY=                         # SECRET, optional, enables /api/admin/stats (20+ chars in production)
# Everything else has a default and is documented in docs/CONFIGURATION.md
