<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Spring Boot 3.5 is out of open-source support (June 2026); 4.1.x is current. Bump to the latest 4.1.x patch. -->
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.priceagent</groupId>
  <artifactId>collector-spring</artifactId>
  <version>1.0.0</version>
  <name>price-agent-collector-spring</name>
  <description>Spring Boot collector: reads product pages, extracts prices, sends them to the Node API</description>

  <properties>
    <java.version>21</java.version>
    <jackson2.version>2.22.3</jackson2.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The core uses Jackson 2 explicitly; pin the whole family so versions never mix. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
